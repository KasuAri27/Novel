{
  "name": "interactive-novel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "模块化互动小说：md + logic.yaml → story.json → 引擎 → 播放器",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
